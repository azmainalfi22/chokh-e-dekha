# ---------------------------------------------------------------------------
# Chokh-e-Dekha environment variables
# Copy to .env.local and fill in. NEXT_PUBLIC_* values are safe for the browser.
# ---------------------------------------------------------------------------

# Supabase (project: chokh-e-dekha, region ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only: service role key (NEVER expose to the client).
# Get it from Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Resend) — server only
RESEND_API_KEY=
EMAIL_FROM="Chokh-e-Dekha <noreply@yourdomain>"

# Cron — shared secret for the scheduled SLA breach sweep.
# Vercel Cron sends this as a bearer token automatically once it is set on the
# project. Without it /api/cron/sla-sweep refuses to run rather than running open.
CRON_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
